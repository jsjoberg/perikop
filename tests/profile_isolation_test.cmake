file(REMOVE_RECURSE "${PROFILE_DIR}")
file(MAKE_DIRECTORY "${PROFILE_DIR}")
foreach(name user.db pronunciation-review.db speech-cache.db)
    file(WRITE "${PROFILE_DIR}/${name}" "Personal profile sentinel: ${name}\n")
endforeach()
foreach(mode --smoke-test --render-benchmark)
    execute_process(COMMAND "${APP}" "${mode}" --profile "${PROFILE_DIR}" --resources "${RESOURCES}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${mode} failed with an isolated profile: ${status}\n${output}\n${error}")
    endif()
    file(GLOB files "${PROFILE_DIR}/*")
    list(LENGTH files count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "${mode} created files in the personal profile")
    endif()
    foreach(name user.db pronunciation-review.db speech-cache.db)
        file(READ "${PROFILE_DIR}/${name}" content)
        if(NOT content STREQUAL "Personal profile sentinel: ${name}\n")
            message(FATAL_ERROR "${mode} modified ${name}")
        endif()
    endforeach()
endforeach()
file(REMOVE_RECURSE "${PROFILE_DIR}")
