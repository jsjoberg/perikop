# LeakSanitizer suppressions for `tools/ci/build.py linux-sanitizers`.
# Only system libraries that keep process-lifetime state; never Perikop's own code in src/.
# A leaked Perikop object is still reported through its own allocation stack.
# System libraries built without frame pointers cut leak stacks short inside them: match modules.

# Fontconfig keeps its configuration, font patterns and caches until FcFini, which
# GTK, Pango, cairo and wxWidgets never call.
leak:libfontconfig.so.1

# librsvg keeps parsed SVG icon data that GTK's icon theme caches for the process.
leak:librsvg-2.so.2

# Mesa keeps the GLX state that GDK's OpenGL probe (through libepoxy) creates when it opens the display.
leak:libGLX_mesa.so.0
