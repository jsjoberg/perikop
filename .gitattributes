* text=auto eol=lf
*.ttf binary
*.db binary
*.png binary

*.zip binary
*.icns binary
*.ico binary

# Pinned upstream files keep their exact bytes; resources/manifest.json records their hashes.
resources/corpus/provenance/** -text
resources/licenses/** -text

# Vendored upstream sources keep their exact bytes; THIRD-PARTY-NOTICES.md records their commits and hashes.
third_party/** -text
