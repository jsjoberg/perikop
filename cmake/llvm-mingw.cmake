# Cross-compile Windows builds from Linux with llvm-mingw.
# Put llvm-mingw's bin folder on PATH before configuring with this toolchain.
set(PERIKOP_WINDOWS_ARCH x86_64 CACHE STRING "Windows target: x86_64 or aarch64")
set_property(CACHE PERIKOP_WINDOWS_ARCH PROPERTY STRINGS x86_64 aarch64)
if(NOT PERIKOP_WINDOWS_ARCH MATCHES "^(x86_64|aarch64)$")
    message(FATAL_ERROR "Unsupported Windows architecture: ${PERIKOP_WINDOWS_ARCH}")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PERIKOP_WINDOWS_ARCH)
set(CMAKE_SYSTEM_NAME Windows)
if(PERIKOP_WINDOWS_ARCH STREQUAL "aarch64")
    set(CMAKE_SYSTEM_PROCESSOR ARM64)
else()
    set(CMAKE_SYSTEM_PROCESSOR AMD64)
endif()
set(perikop_mingw_triple "${PERIKOP_WINDOWS_ARCH}-w64-mingw32")
find_program(perikop_mingw_clang "${perikop_mingw_triple}-clang" REQUIRED)
cmake_path(GET perikop_mingw_clang PARENT_PATH perikop_mingw_bin)
cmake_path(GET perikop_mingw_bin PARENT_PATH perikop_mingw_root)
set(CMAKE_C_COMPILER "${perikop_mingw_clang}")
set(CMAKE_CXX_COMPILER "${perikop_mingw_clang}++")
set(CMAKE_RC_COMPILER "${perikop_mingw_bin}/${perikop_mingw_triple}-windres")
# Do not use host libraries or headers for Windows targets.
set(CMAKE_FIND_ROOT_PATH "${perikop_mingw_root}/${perikop_mingw_triple}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
