# Compile the upstream patterns without requiring TeX or a preparation runtime.
set(perikop_hyphenation_header "${CMAKE_BINARY_DIR}/generated/perikop_hyphenation.hpp")
set(perikop_hyphenation_notices "${CMAKE_BINARY_DIR}/generated/Hyphenation-NOTICES.txt")
set(perikop_hyphenation_data "#pragma once\n#include <array>\n#include <string_view>\nnamespace ortho::hyphenation_data {\nstruct Dictionary {\n    const char* language;\n    std::string_view patterns, exceptions;\n    int left, right;\n};\ninline constexpr std::array<Dictionary, 3> dictionaries{{\n")
set(perikop_hyphenation_license "Hyphenation pattern notices\n\nThe compiled data is generated from the following unmodified hyph-utf8 sources.\n\n")
foreach(language sv grc en-us)
    set(input "${CMAKE_SOURCE_DIR}/resources/hyphenation/hyph-${language}.tex")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(READ "${input}" source)
    # Keep the complete source header in the installed license notices.
    string(FIND "${source}" "\\patterns{" header_end)
    if(header_end LESS 0)
        message(FATAL_ERROR "Missing hyphenation patterns: ${input}")
    endif()
    string(SUBSTRING "${source}" 0 ${header_end} header)
    string(REGEX REPLACE "(^|\n)% ?" "\\1" header "${header}")
    string(APPEND perikop_hyphenation_license "hyph-${language}.tex\n${header}\n")
    string(REGEX REPLACE "%[^\n]*" "" cleaned "${source}")
    string(REGEX MATCH "\\\\patterns\\{([^}]*)\\}" block "${cleaned}")
    if(NOT block)
        message(FATAL_ERROR "Invalid hyphenation patterns: ${input}")
    endif()
    string(REGEX REPLACE "[ \t\r\n]+" "\n" patterns "${CMAKE_MATCH_1}")
    string(STRIP "${patterns}" patterns)
    string(REGEX MATCH "\\\\hyphenation\\{([^}]*)\\}" block "${cleaned}")
    set(exceptions "")
    if(block)
        string(REGEX REPLACE "[ \t\r\n]+" "\n" exceptions "${CMAKE_MATCH_1}")
        string(STRIP "${exceptions}" exceptions)
    elseif(cleaned MATCHES "\\\\hyphenation\\{")
        message(FATAL_ERROR "Invalid hyphenation exceptions: ${input}")
    endif()
    set(code "${language}")
    set(left 2)
    set(right 2)
    if(language STREQUAL "grc")
        set(code el)
        set(left 1)
        set(right 1)
    elseif(language STREQUAL "en-us")
        set(code en)
        set(right 3)
    endif()
    string(APPEND perikop_hyphenation_data
        "    {\"${code}\", R\"patterns(${patterns})patterns\", R\"patterns(${exceptions})patterns\", ${left}, ${right}},\n")
endforeach()
string(APPEND perikop_hyphenation_data "}};\n} // namespace ortho::hyphenation_data\n")
file(CONFIGURE OUTPUT "${perikop_hyphenation_header}" CONTENT "${perikop_hyphenation_data}" @ONLY)
file(CONFIGURE OUTPUT "${perikop_hyphenation_notices}" CONTENT "${perikop_hyphenation_license}" @ONLY)
