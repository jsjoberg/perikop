#include <windows.h>
#include "perikop_version.hpp"
1 RT_MANIFEST "reader.manifest"

1 ICON "../resources/icons/OrthodoxReader.ico"

1 VERSIONINFO
FILEVERSION PERIKOP_VERSION_NUMBERS
PRODUCTVERSION PERIKOP_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Perikop\0"
            VALUE "FileDescription", "Perikop\0"
            VALUE "FileVersion", PERIKOP_VERSION "\0"
            VALUE "InternalName", "perikop\0"
            VALUE "OriginalFilename", "perikop.exe\0"
            VALUE "ProductName", "Perikop\0"
            VALUE "ProductVersion", PERIKOP_VERSION "\0"
            VALUE "LegalCopyright", "Perikop contributors. MIT license.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
